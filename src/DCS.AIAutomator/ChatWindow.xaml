<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DCS.AIAutomator.ChatWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Chat — DCS.AIAutomator">

    <Grid x:Name="RootGrid" RequestedTheme="Dark" Background="{ThemeResource PanelBackgroundBrush}" Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: what this is, where prompts go, and starting over -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock Text="CHAT" Style="{StaticResource EyebrowLabelStyle}" />
                <TextBlock x:Name="NoticeText" Style="{StaticResource SettingsCardDescriptionStyle}" TextWrapping="Wrap"
                           Text="Runs through your Claude Code login. Your messages and the DCS state its tools read are sent to Claude." />
            </StackPanel>
            <Button Grid.Column="1" Content="New chat" Click="OnNewChatClicked" VerticalAlignment="Top" />
        </Grid>

        <!-- Transcript -->
        <ScrollViewer x:Name="TranscriptScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Transcript" Spacing="10" Padding="0,0,12,0" />
        </ScrollViewer>

        <!-- Input -->
        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="PromptBox" PlaceholderText="Ask about your flight or give an ATC instruction…  (Enter to send)"
                     TextWrapping="Wrap" MaxHeight="120" KeyDown="OnPromptKeyDown" />
            <Button x:Name="SendButton" Grid.Column="1" Content="Send" Click="OnSendClicked" VerticalAlignment="Bottom" Style="{StaticResource AccentButtonStyle}" />
        </Grid>
    </Grid>
</Window>
