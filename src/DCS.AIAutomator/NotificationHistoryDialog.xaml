<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="DCS.AIAutomator.NotificationHistoryDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Notification history"
    PrimaryButtonText="Close"
    DefaultButton="Primary">

    <ListView x:Name="HistoryList" MaxHeight="360" SelectionMode="None">
        <ListView.ItemTemplate>
            <DataTemplate>
                <Grid ColumnSpacing="12" Padding="0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="2" Width="120">
                        <TextBlock Text="{Binding TimestampText}" Style="{StaticResource SubtleMonoStyle}" />
                        <TextBlock Text="{Binding SeverityText}" Style="{StaticResource EyebrowLabelStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource SettingsCardTitleStyle}" />
                        <TextBlock Text="{Binding Message}" Style="{StaticResource SettingsCardDescriptionStyle}" />
                    </StackPanel>
                </Grid>
            </DataTemplate>
        </ListView.ItemTemplate>
    </ListView>
</ContentDialog>
