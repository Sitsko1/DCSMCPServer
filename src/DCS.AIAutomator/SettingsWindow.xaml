<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DCS.AIAutomator.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DCS.AIAutomator"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Settings — DCS.AIAutomator">

    <Grid x:Name="RootGrid" RequestedTheme="Dark" Background="{ThemeResource PanelBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <NavigationView x:Name="SectionNav" Grid.Row="0" PaneDisplayMode="Top" IsBackButtonVisible="Collapsed"
                         IsSettingsVisible="False" SelectionChanged="OnSectionChanged" Background="{ThemeResource PanelBackgroundBrush}">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Connection" Tag="Connection" IsSelected="True" />
                <NavigationViewItem Content="Paths" Tag="Paths" />
                <NavigationViewItem Content="DCS Integration" Tag="Integration" />
                <NavigationViewItem Content="Notifications" Tag="Notifications" />
            </NavigationView.MenuItems>
        </NavigationView>

        <ScrollViewer Grid.Row="1" Padding="24,16">
            <StackPanel Spacing="12">

                <!-- Connection -->
                <StackPanel x:Name="ConnectionPanel" Spacing="12">
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="140" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="MCP server port" Style="{StaticResource SettingsCardTitleStyle}" />
                                <TextBlock Text="Port the MCP server listens on for tool calls from an MCP client." Style="{StaticResource SettingsCardDescriptionStyle}" />
                            </StackPanel>
                            <NumberBox x:Name="McpPortBox" Grid.Column="1" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Compact" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="140" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="DCS host" Style="{StaticResource SettingsCardTitleStyle}" />
                                <TextBlock Text="Address DCS's Hooks script socket is reachable at. Leave as 127.0.0.1 unless DCS runs on another machine." Style="{StaticResource SettingsCardDescriptionStyle}" />
                            </StackPanel>
                            <TextBox x:Name="DcsHostBox" Grid.Column="1" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="140" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="DCS port" Style="{StaticResource SettingsCardTitleStyle}" />
                                <TextBlock Text="Port the deployed Hooks script listens on for this app to connect to." Style="{StaticResource SettingsCardDescriptionStyle}" />
                            </StackPanel>
                            <NumberBox x:Name="DcsPortBox" Grid.Column="1" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Compact" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Button Content="Reset to defaults" Click="OnResetConnectionClicked" HorizontalAlignment="Left" />
                </StackPanel>

                <!-- Paths -->
                <StackPanel x:Name="PathsPanel" Spacing="12" Visibility="Collapsed">
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Spacing="8">
                            <StackPanel Spacing="2">
                                <TextBlock Text="DCS install path" Style="{StaticResource SettingsCardTitleStyle}" />
                                <TextBlock Text="Where DCS World is installed." Style="{StaticResource SettingsCardDescriptionStyle}" />
                            </StackPanel>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="InstallPathBox" Grid.Column="0" TextChanged="OnPathTextChanged" />
                                <Button Grid.Column="1" Content="Browse…" Click="OnBrowseInstallPathClicked" />
                            </Grid>
                            <TextBlock x:Name="InstallPathError" Style="{StaticResource SettingsCardDescriptionStyle}"
                                       Foreground="{ThemeResource FaultBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Spacing="8">
                            <StackPanel Spacing="2">
                                <TextBlock Text="DCS Saved Games path" Style="{StaticResource SettingsCardTitleStyle}" />
                                <TextBlock Text="Where DCS stores this user's Scripts folder — the Hooks script gets deployed here." Style="{StaticResource SettingsCardDescriptionStyle}" />
                            </StackPanel>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="SavedGamesPathBox" Grid.Column="0" TextChanged="OnPathTextChanged" />
                                <Button Grid.Column="1" Content="Browse…" Click="OnBrowseSavedGamesPathClicked" />
                            </Grid>
                            <TextBlock x:Name="SavedGamesPathError" Style="{StaticResource SettingsCardDescriptionStyle}"
                                       Foreground="{ThemeResource FaultBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- DCS Integration -->
                <StackPanel x:Name="IntegrationPanel" Spacing="12" Visibility="Collapsed">
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Spacing="8">
                            <StackPanel Spacing="2">
                                <TextBlock Text="DCS Hooks script" Style="{StaticResource SettingsCardTitleStyle}" />
                                <TextBlock Text="Writes DCSMcpBridgeHooks.lua to Saved Games\DCS\Scripts\Hooks, which DCS loads on startup — Export.lua is not modified. Also removes this app's script from older versions out of Export.lua (other tools' lines are kept, and a backup is made). Restart DCS after deploying. Safe to run again after changing the DCS port." Style="{StaticResource SettingsCardDescriptionStyle}" />
                            </StackPanel>
                            <Button Content="Deploy Lua scripts" Click="OnDeployClicked" HorizontalAlignment="Left" />
                            <TextBlock x:Name="DeployStatusText" Style="{StaticResource SubtleMonoStyle}" Text="—" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Notifications -->
                <StackPanel x:Name="NotificationsPanel" Spacing="12" Visibility="Collapsed">
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="140" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Notification duration" Style="{StaticResource SettingsCardTitleStyle}" />
                                <TextBlock Text="How long each toast notification stays on screen, in seconds." Style="{StaticResource SettingsCardDescriptionStyle}" />
                            </StackPanel>
                            <NumberBox x:Name="ToastDurationBox" Grid.Column="1" Minimum="1" Maximum="60" SpinButtonPlacementMode="Compact" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource HairlineBrush}" Padding="24,12">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <TextBlock x:Name="SaveStatusText" Style="{StaticResource SubtleMonoStyle}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <Button Content="Save &amp; restart bridge" Click="OnSaveClicked" Style="{ThemeResource AccentButtonStyle}" />
                <Button Content="Cancel" Click="OnCancelClicked">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Escape" />
                    </Button.KeyboardAccelerators>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
