<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DCS.AIAutomator.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DCS.AIAutomator"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Settings — DCS.AIAutomator">

    <Grid x:Name="RootGrid" RequestedTheme="Dark" Background="{ThemeResource PanelBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <NavigationView x:Name="SectionNav" Grid.Row="0" PaneDisplayMode="Top" IsBackButtonVisible="Collapsed"
                         IsSettingsVisible="False" SelectionChanged="OnSectionChanged" Background="{ThemeResource PanelBackgroundBrush}">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Connection" Tag="Connection" IsSelected="True" />
                <NavigationViewItem Content="Paths" Tag="Paths" />
                <NavigationViewItem Content="DCS Integration" Tag="Integration" />
            </NavigationView.MenuItems>
        </NavigationView>

        <ScrollViewer Grid.Row="1" Padding="24,16">
            <StackPanel Spacing="12">

                <!-- Connection -->
                <StackPanel x:Name="ConnectionPanel" Spacing="12">
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="140" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="MCP server port" Style="{StaticResource SettingsCardTitleStyle}" />
                                <TextBlock Text="Port the MCP server listens on for tool calls from an MCP client." Style="{StaticResource SettingsCardDescriptionStyle}" />
                            </StackPanel>
                            <NumberBox x:Name="McpPortBox" Grid.Column="1" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Compact" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="140" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="DCS host" Style="{StaticResource SettingsCardTitleStyle}" />
                                <TextBlock Text="Address DCS's Export.lua socket is reachable at. Leave as 127.0.0.1 unless DCS runs on another machine." Style="{StaticResource SettingsCardDescriptionStyle}" />
                            </StackPanel>
                            <TextBox x:Name="DcsHostBox" Grid.Column="1" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="140" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="DCS port" Style="{StaticResource SettingsCardTitleStyle}" />
                                <TextBlock Text="Port the deployed Export.lua script listens on for this app to connect to." Style="{StaticResource SettingsCardDescriptionStyle}" />
                            </StackPanel>
                            <NumberBox x:Name="DcsPortBox" Grid.Column="1" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Compact" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Paths -->
                <StackPanel x:Name="PathsPanel" Spacing="12" Visibility="Collapsed">
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Spacing="8">
                            <StackPanel Spacing="2">
                                <TextBlock Text="DCS install path" Style="{StaticResource SettingsCardTitleStyle}" />
                                <TextBlock Text="Where DCS World is installed." Style="{StaticResource SettingsCardDescriptionStyle}" />
                            </StackPanel>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="InstallPathBox" Grid.Column="0" />
                                <Button Grid.Column="1" Content="Browse…" Click="OnBrowseInstallPathClicked" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Spacing="8">
                            <StackPanel Spacing="2">
                                <TextBlock Text="DCS Saved Games path" Style="{StaticResource SettingsCardTitleStyle}" />
                                <TextBlock Text="Where DCS stores this user's Scripts folder — Export.lua gets deployed here." Style="{StaticResource SettingsCardDescriptionStyle}" />
                            </StackPanel>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="SavedGamesPathBox" Grid.Column="0" />
                                <Button Grid.Column="1" Content="Browse…" Click="OnBrowseSavedGamesPathClicked" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- DCS Integration -->
                <StackPanel x:Name="IntegrationPanel" Spacing="12" Visibility="Collapsed">
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Spacing="8">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Export.lua integration" Style="{StaticResource SettingsCardTitleStyle}" />
                                <TextBlock Text="Generates DCSMcpBridgeExport.lua in the Saved Games Scripts folder and wires it into Export.lua (appending a dofile line, without touching any other tool's hooks — a backup is made first). Safe to run again after changing the DCS port above." Style="{StaticResource SettingsCardDescriptionStyle}" />
                            </StackPanel>
                            <Button Content="Deploy Lua scripts" Click="OnDeployClicked" HorizontalAlignment="Left" />
                            <TextBlock x:Name="DeployStatusText" Style="{StaticResource SubtleMonoStyle}" Text="—" />
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource HairlineBrush}" Padding="24,12">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <TextBlock x:Name="SaveStatusText" Style="{StaticResource SubtleMonoStyle}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <Button Content="Save &amp; restart bridge" Click="OnSaveClicked" Style="{ThemeResource AccentButtonStyle}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
