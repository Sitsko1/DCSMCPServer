<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Theme-specific brushes: use ThemeDictionaries so light/dark variants can be provided. -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#F6F7F8" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="HairlineBrush" Color="#E1E6E6" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#111213" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6B6F6F" />
            <SolidColorBrush x:Key="NominalBrush" Color="#0A8A3D" />
            <SolidColorBrush x:Key="WarningBrush" Color="#B36A00" />
            <SolidColorBrush x:Key="FaultBrush" Color="#A80000" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#0E1416" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#161D20" />
            <SolidColorBrush x:Key="HairlineBrush" Color="#23302E" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E8F0EE" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#7C9490" />
            <SolidColorBrush x:Key="NominalBrush" Color="#3ECF8E" />
            <SolidColorBrush x:Key="WarningBrush" Color="#F2B84B" />
            <SolidColorBrush x:Key="FaultBrush" Color="#E85D5D" />
        </ResourceDictionary>

        <!-- Fallback/default dictionary -->
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#0E1416" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#161D20" />
            <SolidColorBrush x:Key="HairlineBrush" Color="#23302E" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E8F0EE" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#7C9490" />
            <SolidColorBrush x:Key="NominalBrush" Color="#3ECF8E" />
            <SolidColorBrush x:Key="WarningBrush" Color="#F2B84B" />
            <SolidColorBrush x:Key="FaultBrush" Color="#E85D5D" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Shared fonts and styles. Use ThemeResource to reference brushes so they follow the active theme. -->
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display</FontFamily>
    <FontFamily x:Key="TextFont">Segoe UI Variable Text</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, monospace</FontFamily>

    <Style x:Key="EyebrowLabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="60" />
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
    </Style>

    <Style x:Key="AnnunciatorStateStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="20" />
    </Style>

    <Style x:Key="SubtleMonoStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="40" />
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="FieldValueStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
