<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DCS.AIAutomator.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DCS.AIAutomator"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="DCS.AIAutomator">

    <!--
        Glass-cockpit annunciator panel, not a translucent Mica surface — the exact palette below
        is the point, so it shouldn't drift with the desktop wallpaper/theme. Two annunciators
        (Bridge, DCS) read like glareshield master-caution lights: the first, most critical glance.
        Everything below is a quiet instrument readout.
    -->
    <Grid x:Name="RootGrid" RequestedTheme="Dark" Background="{ThemeResource PanelBackgroundBrush}">
        <Grid.Resources>
            <!-- Storyboards remain local because they target named elements in this window -->
            <Storyboard x:Key="BridgePulseStoryboard">
                <DoubleAnimation Storyboard.TargetName="BridgeLamp" Storyboard.TargetProperty="Opacity"
                                  From="1.0" To="0.35" Duration="0:0:0.9" AutoReverse="True" RepeatBehavior="Forever" />
            </Storyboard>
            <Storyboard x:Key="DcsPulseStoryboard">
                <DoubleAnimation Storyboard.TargetName="DcsLamp" Storyboard.TargetProperty="Opacity"
                                  From="1.0" To="0.35" Duration="0:0:0.9" AutoReverse="True" RepeatBehavior="Forever" />
            </Storyboard>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- Toolbar: settings + theme toggle, styled as chromeless glass icon buttons -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0">
            <Button Style="{StaticResource GlassIconGhostButtonStyle}" Click="OnChatClicked" ToolTipService.ToolTip="Chat with Claude">
                <FontIcon Glyph="&#xE8BD;" FontSize="14" />
            </Button>
            <Button Style="{StaticResource GlassIconGhostButtonStyle}" Click="OnHistoryClicked" ToolTipService.ToolTip="Notification history">
                <FontIcon Glyph="&#xE7F4;" FontSize="14" />
            </Button>
            <Button Style="{StaticResource GlassIconGhostButtonStyle}" Click="OnSettingsClicked" ToolTipService.ToolTip="Settings">
                <FontIcon Glyph="&#xE713;" FontSize="14" />
            </Button>
            <ToggleButton x:Name="ThemeToggle" Style="{StaticResource GlassIconButtonStyle}" Click="OnThemeToggleClicked" ToolTipService.ToolTip="Toggle light/dark theme">
                <FontIcon x:Name="ThemeToggleIcon" Glyph="&#xE706;" FontSize="14" />
            </ToggleButton>
        </StackPanel>
        <!-- Annunciator strip -->
        <Grid Grid.Row="1" Padding="24,12,24,20" ColumnSpacing="12" RowSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Column="0" Background="{ThemeResource SurfaceBrush}" CornerRadius="6" Padding="16,14">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border x:Name="BridgeLamp" Width="10" Height="10" CornerRadius="2" Background="{ThemeResource TextSecondaryBrush}" />
                        <TextBlock Text="MCP BRIDGE" Style="{StaticResource EyebrowLabelStyle}" />
                    </StackPanel>
                    <TextBlock x:Name="BridgeStateText" Text="STOPPED" Style="{StaticResource AnnunciatorStateStyle}" Foreground="{ThemeResource TextSecondaryBrush}" />
                    <TextBlock x:Name="BridgeUrlText" Text="—" Style="{StaticResource SubtleMonoStyle}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="{ThemeResource SurfaceBrush}" CornerRadius="6" Padding="16,14">
                <StackPanel Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border x:Name="DcsLamp" Width="10" Height="10" CornerRadius="2" Background="{ThemeResource TextSecondaryBrush}" />
                        <TextBlock Text="DCS CONNECTION" Style="{StaticResource EyebrowLabelStyle}" />
                    </StackPanel>
                    <TextBlock x:Name="DcsStateText" Text="DISCONNECTED" Style="{StaticResource AnnunciatorStateStyle}" Foreground="{ThemeResource TextSecondaryBrush}" />
                    <TextBlock x:Name="DcsAddressText" Text="—" Style="{StaticResource SubtleMonoStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
                        <Button x:Name="DcsStartQuitButton" Content="Start DCS" Click="OnDcsStartQuitClicked" FontSize="12" Padding="10,3" />
                        <Button x:Name="DcsPauseButton" Content="Pause" Click="OnDcsPauseClicked" FontSize="12" Padding="10,3" IsEnabled="False" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- AI agents reaching the MCP server (stateless: "active" = a request in the last minute) -->
            <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{ThemeResource SurfaceBrush}" CornerRadius="6" Padding="16,14">
                <StackPanel Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border x:Name="ClientsLamp" Width="10" Height="10" CornerRadius="2" Background="{ThemeResource TextSecondaryBrush}" />
                        <TextBlock Text="AI CLIENTS" Style="{StaticResource EyebrowLabelStyle}" />
                    </StackPanel>
                    <TextBlock x:Name="ClientsStateText" Text="NO CLIENTS" Style="{StaticResource AnnunciatorStateStyle}" Foreground="{ThemeResource TextSecondaryBrush}" />
                    <TextBlock x:Name="ClientsDetailText" Text="—" Style="{StaticResource SubtleMonoStyle}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Height="1" Background="{ThemeResource HairlineBrush}" Margin="24,0" />

        <!-- Mission readout + aircraft status; scrolls when the expander doesn't fit the window -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="24,20,24,24" Spacing="20">
                <!-- Mission readout -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="MISSION" Style="{StaticResource EyebrowLabelStyle}" Margin="0,0,0,16" />

                    <StackPanel x:Name="NoMissionPanel" Grid.Row="1" Spacing="4" VerticalAlignment="Top">
                        <TextBlock Text="No active mission" FontFamily="{StaticResource DisplayFont}" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" />
                        <TextBlock Text="Waiting for DCS telemetry." FontFamily="{StaticResource TextFont}" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" />
                    </StackPanel>

                    <Grid x:Name="MissionDetailPanel" Grid.Row="1" Visibility="Collapsed" RowSpacing="12" VerticalAlignment="Top">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="AIRCRAFT" Style="{StaticResource FieldLabelStyle}" />
                        <TextBlock x:Name="AircraftText" Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldValueStyle}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="MISSION" Style="{StaticResource FieldLabelStyle}" />
                        <TextBlock x:Name="MissionNameText" Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldValueStyle}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="TERRAIN" Style="{StaticResource FieldLabelStyle}" />
                        <TextBlock x:Name="TerrainText" Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldValueStyle}" />

                    </Grid>
                </Grid>

                <!-- Aircraft status: live ownship readout (~5 Hz), in the units chosen in Settings > Display -->
                <Expander x:Name="AircraftExpander" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          Background="{ThemeResource SurfaceBrush}">
                    <Expander.Header>
                        <TextBlock Text="AIRCRAFT STATUS" Style="{StaticResource EyebrowLabelStyle}" />
                    </Expander.Header>
                    <StackPanel>
                        <TextBlock x:Name="NoAircraftText" Text="No active aircraft" FontFamily="{StaticResource TextFont}" FontSize="12"
                                   Foreground="{ThemeResource TextSecondaryBrush}" />
                        <TextBlock x:Name="AircraftHeldText" Style="{StaticResource EyebrowLabelStyle}" Visibility="Collapsed"
                                   TextWrapping="Wrap" Margin="0,0,0,10" />
                        <Grid x:Name="AircraftDetailPanel" Visibility="Collapsed" RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="88" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="POSITION" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock x:Name="PositionText" Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldValueStyle}" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="ALT MSL" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock x:Name="AltMslText" Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldValueStyle}" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="ALT AGL" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock x:Name="AltAglText" Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldValueStyle}" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="IAS" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock x:Name="IasText" Grid.Row="3" Grid.Column="1" Style="{StaticResource FieldValueStyle}" />
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="TAS" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock x:Name="TasText" Grid.Row="4" Grid.Column="1" Style="{StaticResource FieldValueStyle}" />
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="MACH" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock x:Name="MachText" Grid.Row="5" Grid.Column="1" Style="{StaticResource FieldValueStyle}" />
                            <TextBlock Grid.Row="6" Grid.Column="0" Text="V/S" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock x:Name="VsText" Grid.Row="6" Grid.Column="1" Style="{StaticResource FieldValueStyle}" />
                            <TextBlock Grid.Row="7" Grid.Column="0" Text="HEADING" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock x:Name="HeadingText" Grid.Row="7" Grid.Column="1" Style="{StaticResource FieldValueStyle}" />
                            <TextBlock Grid.Row="8" Grid.Column="0" Text="FAULTS" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock x:Name="FaultsText" Grid.Row="8" Grid.Column="1" Style="{StaticResource FieldValueStyle}" />
                        </Grid>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>