<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DCS.AIAutomator.ChatView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: what this is, where prompts go, starting over, and where the chat lives -->
        <Grid Grid.Row="0" ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock Text="CHAT" Style="{StaticResource EyebrowLabelStyle}" />
                <TextBlock Style="{StaticResource SettingsCardDescriptionStyle}" TextWrapping="Wrap"
                           Text="Runs through your Claude Code login. Your messages and the DCS state its tools read are sent to Claude." />
            </StackPanel>
            <Button Grid.Column="1" Content="New chat" Click="OnNewChatClicked" VerticalAlignment="Top" />
            <Button x:Name="PopButton" Grid.Column="2" Click="OnPopClicked" VerticalAlignment="Top">
                <FontIcon x:Name="PopIcon" Glyph="&#xE8A7;" FontSize="14" />
            </Button>
            <Button x:Name="CloseButton" Grid.Column="3" Click="OnCloseClicked" VerticalAlignment="Top" ToolTipService.ToolTip="Close chat">
                <FontIcon Glyph="&#xE711;" FontSize="14" />
            </Button>
        </Grid>

        <!-- Transcript -->
        <ScrollViewer x:Name="TranscriptScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Transcript" Spacing="10" Padding="0,0,12,0" />
        </ScrollViewer>

        <!-- Input -->
        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="PromptBox" PlaceholderText="Ask about your flight or give an ATC instruction…  (Enter to send)"
                     TextWrapping="Wrap" MaxHeight="120" KeyDown="OnPromptKeyDown" />
            <Button x:Name="SendButton" Grid.Column="1" Content="Send" Click="OnSendClicked" VerticalAlignment="Bottom" Style="{StaticResource AccentButtonStyle}" />
        </Grid>
    </Grid>
</UserControl>
